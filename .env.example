# Contact form delivery (server-only; never prefix with NEXT_PUBLIC_).
# Works with Resend (https://resend.com) or any API that accepts the same JSON.
# Leave unset and the form shows its error state instead of sending.

# Address that receives the messages.
CONTACT_TO=
# Verified sender, e.g. "Portfolio <contact@your-domain>".
CONTACT_FROM=
# API key from the email provider.
CONTACT_API_KEY=
# Optional override of the provider endpoint (defaults to https://api.resend.com/emails).
# CONTACT_API_URL=
